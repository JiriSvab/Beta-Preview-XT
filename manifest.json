{
  "manifest_version": 3,
  "name": "Beta Preview XT",
  "version": "0.1",
  "action": {
    "default_title": "Click for more...",
    "default_popup": "popup.html"
  },
  "description": "Sitecore editor enhancement tool",
  "icons": {"48" : "img/SiteScript_favicon.png"},
  "author": "Jiri Svab",
  "background": {
    "service_worker": "js/background.js"
  },
  "chrome_url_overrides": {},
  "commands": {},
  "content_scripts": [
          {
            "matches": ["<all_urls>"],
            "style": ["style/main.css"],
            "js": ["js/quick-info-utils.js", "js/site-mapping.js", "js/language-map.js", "js/content.js", "js/quick-info-enhancement.js", "js/quick-info-links.js"]
          },
          {
            "matches": ["<all_urls>"],
            "all_frames": true,
            "js": ["js/language-picker-sync.js"]
          }
        ],
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["js/languages.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
